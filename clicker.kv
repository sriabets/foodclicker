#:import from_hex kivy.utils.get_color_from_hex
#:import colormap kivy.utils.colormap

#:set main_color "#F3AF12"
#:set main_color_dark "#F37C12"

<MainButton@ButtonBehavior+Widget>:
    size_hint: 0.15, None
    height: self.width
    img_src: "assets/image/shop.png" 

    canvas.before:
        Color:
            rgba: (0.8, 0.8, 0.8, 1) if self.state == 'down' else (1, 1, 1, 1)
        Ellipse:
            pos: self.pos
            size: self.size
            source: root.img_src 

<ShopCard@ButtonBehavior+BoxLayout>:
    orientation: 'vertical'
    size_hint: 1, 1
    padding: "8dp"
    spacing: "4dp"
    img_src: ""            
    price_text: "0"        

    canvas.before:
        Color:
            rgba: from_hex("#F3AF12")
        Line:
            rounded_rectangle: (self.x, self.y, self.width, self.height, 15)
            width: 2
        Color:
            rgba: 0, 0, 0, 0.2
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [15]

    Widget:
        size_hint_y: 0.75
        canvas.before:
            Color:
                rgba: 1, 1, 1, 1 if root.img_src else 0
            Rectangle:
                pos: self.x + (self.width - min(self.width, self.height)) / 2, self.y
                size: min(self.width, self.height), min(self.width, self.height)
                source: root.img_src

    BoxLayout:
        size_hint_y: 0.25
        canvas.before:
            Color:
                rgba: from_hex("#F37C12")
            RoundedRectangle:
                pos: self.pos
                size: self.size
                radius: [0, 0, 15, 15]
        Label:
            text: root.price_text + " Coins"
            font_size: "14sp"
            font_name: app.game_font
            bold: True
            color: 1, 1, 1, 1
            halign: 'center'
            valign: 'middle'

<TargetButton>:
    # Адаптивний розмір мішені: 60% ширини екрана для 1 рівня, 55% для 2 рівня.
    size_hint: (0.6, None) if self.parent and self.parent.parent.current_level == 1 else (0.55, None)
    height: self.width if self.parent and self.parent.parent.current_level == 1 else self.width * 1.3
    pos_hint: self.pos_hint

    canvas.before:
        PushMatrix
        Rotate:
            angle: self.angle if self.parent and self.parent.parent.current_level == 1 else 0
            axis: 0, 0, 1
            origin: self.center
            
        Color:
            rgba: (0.6, 0.6, 0.6, root.opacity if root.hp > 0 else 0) if self.parent and self.parent.parent.current_level == 1 else (0.55, 0.35, 0.15, root.opacity if root.hp > 0 else 0)
            
        Ellipse:
            pos: (root.x - 10, root.y - 10) if root.parent and root.parent.parent.current_level == 1 else (-1000, -1000)
            size: (root.width + 20, root.height + 20) if root.parent and root.parent.parent.current_level == 1 else (1, 1)
            
        Rectangle:
            pos: root.pos if root.parent and root.parent.parent.current_level == 2 else (-1000, -1000)
            size: root.size if root.parent and root.parent.parent.current_level == 2 else (1, 1)

        Color:
            rgba: 1, 1, 1, root.opacity if root.hp > 0 else 0
        Ellipse:
            pos: root.pos if root.parent and root.parent.parent.current_level == 1 else (-1000, -1000)
            size: root.size if root.parent and root.parent.parent.current_level == 1 else (1, 1)
            source: root.parent.parent.target_img if root.parent and root.parent.parent and root.parent.parent.current_level == 1 else ""
            angle_start: 0
            angle_end: int((root.hp / 6) * 360)
            
        Rectangle:
            pos: (root.x + 10, root.y + 10) if root.parent and root.parent.parent.current_level == 2 else (-1000, -1000)
            size: (root.width - 20, root.height - 20) if root.parent and root.parent.parent.current_level == 2 else (1, 1)
            source: root.parent.parent.target_img if root.parent and root.parent.parent and root.parent.parent.current_level == 2 else ""

        Color:
            rgba: (0.55, 0.35, 0.15, 1.0 * root.opacity) if (root.parent and root.parent.parent.current_level == 2) else (0, 0, 0, 0)
        
        # Сектори для суші (рівень 2)
        Rectangle:
            pos: (root.x + 10, root.y + 10 + (root.height - 20) * 2 / 3) if (root.parent and root.parent.parent.current_level == 2 and root.hp <= 5) else (-1000, -1000)
            size: ((root.width - 20) / 2, (root.height - 20) / 3)
            
        Rectangle:
            pos: (root.x + 10 + (root.width - 20) / 2, root.y + 10 + (root.height - 20) * 2 / 3) if (root.parent and root.parent.parent.current_level == 2 and root.hp <= 4) else (-1000, -1000)
            size: ((root.width - 20) / 2, (root.height - 20) / 3)
            
        Rectangle:
            pos: (root.x + 10, root.y + 10 + (root.height - 20) / 3) if (root.parent and root.parent.parent.current_level == 2 and root.hp <= 3) else (-1000, -1000)
            size: ((root.width - 20) / 2, (root.height - 20) / 3)
            
        Rectangle:
            pos: (root.x + 10 + (root.width - 20) / 2, root.y + 10 + (root.height - 20) / 3) if (root.parent and root.parent.parent.current_level == 2 and root.hp <= 2) else (-1000, -1000)
            size: ((root.width - 20) / 2, (root.height - 20) / 3)
            
        Rectangle:
            pos: (root.x + 10, root.y + 10) if (root.parent and root.parent.parent.current_level == 2 and root.hp <= 1) else (-1000, -1000)
            size: ((root.width - 20) / 2, (root.height - 20) / 3)
            
        Rectangle:
            pos: (root.x + 10 + (root.width - 20) / 2, root.y + 10) if (root.parent and root.parent.parent.current_level == 2 and root.hp <= 0) else (-1000, -1000)
            size: ((root.width - 20) / 2, (root.height - 20) / 3)
            
        PopMatrix

<MenuScreen>:
    FloatLayout:
        canvas.before:
            Color:
                rgba: 1, 1, 1, 1
            Rectangle:
                pos: self.pos
                size: self.size
                source: root.bg_image

        Label:
            text: "Main Menu"
            font_size: "40sp"
            font_name: app.game_font
            size_hint: None, None
            size: self.texture_size
            pos_hint: {"center_x": 0.5, "top": 0.85}

        Button:
            text: "PLAY"
            font_name: app.game_font
            size_hint: 0.5, 0.1
            pos_hint: {"center_x": 0.5, "center_y": 0.5}
            on_press: root.go_game()
        
        MainButton:
            img_src: "assets/image/setting.png"
            pos_hint: {"x": 0.05, "y": 0.05}
            on_press: root.go_settings()

        MainButton:
            img_src: "assets/image/exit.png"
            pos_hint: {"right": 0.95, "y": 0.05}
            on_press: root.exit_app()

<GameScreen>:
    FloatLayout:
        canvas.before:
            Color:
                rgba: 1, 1, 1, 1
            Rectangle:
                pos: self.pos
                size: self.size
                source: root.game_bg

        Label:
            text: "Coins: " + str(root.points)
            font_size: "24sp"
            font_name: app.game_font
            bold: True
            size_hint: 0.4, 0.08
            pos_hint: {"right": 0.95, "top": 0.95}
            color: 1, 1, 1, 1
            canvas.before:
                Color:
                    rgba: from_hex("#F37C12")
                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [10]
                Color:
                    rgba: from_hex("#F3AF12")
                Line:
                    rounded_rectangle: (self.x, self.y, self.width, self.height, 10)
                    width: 2

        TargetButton:
            id: target_button
            on_press: root.on_pizza_click()
            on_death: root.level_complete()

        MainButton:
            img_src: "assets/image/shop.png"
            pos_hint: {"x": 0.05, "top": 0.95}
            on_press: root.go_shop()

        MainButton:
            img_src: "assets/image/house.png"
            pos_hint: {"x": 0.05, "y": 0.05}
            on_press: root.go_menu()

<SettingsScreen>:
    FloatLayout:
        canvas.before:
            Color:
                rgba: 1, 1, 1, 1
            Rectangle:
                pos: self.pos
                size: self.size
                source: "assets/image/setingfon.jpg"

        Label:
            text: "Settings Menu"
            font_size: "40sp"
            font_name: app.game_font
            size_hint: None, None
            size: self.texture_size
            pos_hint: {"center_x": 0.5, "top": 0.85}

        BoxLayout:
            orientation: 'vertical'
            size_hint: 0.9, 0.4
            spacing: "15dp"
            pos_hint: {"center_x": 0.5, "center_y": 0.42}

            BoxLayout:
                orientation: 'horizontal'
                size_hint_y: 0.33
                spacing: "12dp"

                Button:
                    text: "<"
                    font_size: "22sp"
                    font_name: app.game_font
                    bold: True
                    size_hint_x: 0.2
                    background_color: from_hex("#F37C12")
                    on_press: root.prev_track()

                Label:
                    text: root.current_track_name
                    font_size: "14sp"
                    font_name: app.game_font
                    bold: True
                    color: 0.2, 0.2, 0.2, 1
                    halign: 'center'
                    valign: 'middle'
                    size_hint_x: 0.6
                    text_size: self.size
                    canvas.before:
                        Color:
                            rgba: 1, 1, 1, 1 
                        Rectangle:
                            pos: self.pos
                            size: self.size
                        Color:
                            rgba: 0.6, 0.6, 0.6, 1  
                        Line:
                            rectangle: (self.x, self.y, self.width, self.height)
                            width: 1.5

                Button:
                    text: ">"
                    font_size: "22sp"
                    font_name: app.game_font
                    bold: True
                    size_hint_x: 0.2
                    background_color: from_hex("#F37C12")
                    on_press: root.next_track()

            BoxLayout:
                orientation: 'horizontal'
                size_hint_y: 0.33
                spacing: "15dp"

                Label:
                    text: "Music"
                    font_size: "16sp"
                    font_name: app.game_font
                    bold: True
                    color: 1, 1, 1, 1
                    size_hint_x: 0.3
                    canvas.before:
                        Color:
                            rgba: 0.2, 0.2, 0.2, 1
                        Rectangle:
                            pos: self.pos
                            size: self.size
                        Color:
                            rgba: 0.6, 0.6, 0.6, 1
                        Line:
                            rectangle: (self.x, self.y, self.width, self.height)
                            width: 1.5

                Slider:
                    id: volume_slider
                    min: 0
                    max: 100
                    value: 50
                    size_hint_x: 0.5
                    cursor_image: ''
                    cursor_size: ("20dp", "20dp")
                    canvas.after:
                        Color:
                            rgba: 1, 1, 1, 1
                        Ellipse:
                            pos: (self.value_pos[0] - 10, self.center_y - 10)
                            size: (20, 20)
                    on_value: root.change_volume(self.value)

                Label:
                    text: str(root.music_volume) + "%"
                    font_size: "16sp"
                    font_name: app.game_font
                    bold: True
                    color: 1, 1, 1, 1
                    size_hint_x: 0.2
                    canvas.before:
                        Color:
                            rgba: 0.2, 0.2, 0.2, 1
                        Rectangle:
                            pos: self.pos
                            size: self.size
                        Color:
                            rgba: 0.6, 0.6, 0.6, 1
                        Line:
                            rectangle: (self.x, self.y, self.width, self.height)
                            width: 1.5

            BoxLayout:
                orientation: 'horizontal'
                size_hint_y: 0.33
                spacing: "15dp"

                Label:
                    text: "Sounds"
                    font_size: "16sp"
                    font_name: app.game_font
                    bold: True
                    color: 1, 1, 1, 1
                    size_hint_x: 0.3
                    canvas.before:
                        Color:
                            rgba: 0.2, 0.2, 0.2, 1
                        Rectangle:
                            pos: self.pos
                            size: self.size
                        Color:
                            rgba: 0.6, 0.6, 0.6, 1
                        Line:
                            rectangle: (self.x, self.y, self.width, self.height)
                            width: 1.5

                Slider:
                    id: sounds_slider
                    min: 0
                    max: 100
                    value: 50 
                    size_hint_x: 0.5
                    cursor_image: ''
                    cursor_size: ("20dp", "20dp")
                    canvas.after:
                        Color:
                            rgba: 1, 1, 1, 1
                        Ellipse:
                            pos: (self.value_pos[0] - 10, self.center_y - 10)
                            size: (20, 20)
                    on_value: root.change_sounds_volume(self.value)

                Label:
                    text: str(root.sounds_volume) + "%"
                    font_size: "16sp"
                    font_name: app.game_font
                    bold: True
                    color: 1, 1, 1, 1
                    size_hint_x: 0.2
                    canvas.before:
                        Color:
                            rgba: 0.2, 0.2, 0.2, 1
                        Rectangle:
                            pos: self.pos
                            size: self.size
                        Color:
                            rgba: 0.6, 0.6, 0.6, 1
                        Line:
                            rectangle: (self.x, self.y, self.width, self.height)
                            width: 1.5

        MainButton:
            img_src: "assets/image/house.png"
            pos_hint: {"x": 0.05, "top": 0.95}
            on_press: root.go_menu()

<ShopScreen>:
    FloatLayout:
        canvas.before:
            Color:
                rgba: 1, 1, 1, 1
            Rectangle:
                pos: self.pos
                size: self.size
                source: "assets/image/inshop.jpg"

        Label:
            text: "Shop Menu"
            font_size: "40sp"
            font_name: app.game_font
            size_hint: None, None
            size: self.texture_size
            pos_hint: {"center_x": 0.5, "top": 0.9}

        Label:
            text: "Coins: " + str(root.player_coins)
            font_size: "20sp"
            font_name: app.game_font
            bold: True
            size_hint: 0.4, 0.08
            pos_hint: {"right": 0.95, "top": 0.95}
            color: 1, 1, 1, 1
            canvas.before:
                Color:
                    rgba: from_hex("#F37C12")
                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [10]
                Color:
                    rgba: from_hex("#F3AF12")
                Line:
                    rounded_rectangle: (self.x, self.y, self.width, self.height, 10)
                    width: 2

        BoxLayout:
            orientation: 'vertical'
            size_hint: 0.85, 0.6
            spacing: "20dp"
            pos_hint: {"center_x": 0.5, "center_y": 0.45}

            BoxLayout:
                orientation: 'horizontal'
                size_hint_y: 0.75
                spacing: "20dp"
                
                ShopCard:
                    img_src: "assets/image/rot.png"
                    price_text: str(root.price_item_1)
                    on_press: root.buy_item_1()

                ShopCard:
                    img_src: "assets/image/friends.png"
                    price_text: str(root.price_item_2)
                    on_press: root.buy_item_2()

            BoxLayout:
                orientation: 'vertical'
                size_hint_y: 0.25
                
                Button:
                    text: root.level_text + " (" + str(root.price_level) + ")"
                    font_size: "16sp"
                    font_name: app.game_font
                    background_color: from_hex("#F37C12")
                    on_press: root.buy_level()

        MainButton:
            img_src: "assets/image/xrest.png"
            pos_hint: {"x": 0.05, "top": 0.95}
            on_press: root.go_game()

        FloatLayout:
            id: end_overlay
            pos_hint: {"x": 0, "y": 0}
            size_hint: 0, 0
            opacity: 0
            disabled: True
            
            canvas.before:
                Color:
                    rgba: 0, 0, 0, 0.6 if self.size_hint[0] > 0 else 0
                Rectangle:
                    pos: self.pos
                    size: self.size

            Image:
                source: "assets/image/chest.png" if end_overlay.size_hint[0] > 0 else ""
                # Зроблено адаптивним за допомогою size_hint та height
                size_hint: 0.6, None
                height: self.width
                pos_hint: {"center_x": 0.5, "center_y": 0.5}

            Label:
                text: "Кінець" if end_overlay.size_hint[0] > 0 else ""
                font_size: "54sp"
                bold: True
                color: 1, 1, 1, 1
                size_hint: None, None
                size: self.texture_size
                pos_hint: {"center_x": 0.5, "center_y": 0.75}

            MainButton:
                img_src: "assets/image/exit.png" if end_overlay.size_hint[0] > 0 else ""
                pos_hint: {"center_x": 0.5, "center_y": 0.2}
                on_press: root.exit_app()
